{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBundleObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<bucket-name>/<prefix>/*"
    },
    {
      "Sid": "ListBundlePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<bucket-name>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "<prefix>/artifacts/registry/bundles/*"
          ]
        }
      }
    }
  ]
}
