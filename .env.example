# Runtime environment label used in logs and diagnostics.
HOWRELIABLE_ENVIRONMENT=development

# Standard Python logging level (DEBUG, INFO, WARNING, ERROR, or CRITICAL).
HOWRELIABLE_LOG_LEVEL=INFO

# Artifact loading defaults to the local repository. Set s3 explicitly for remote loading.
HOWRELIABLE_ARTIFACT_BACKEND=local
HOWRELIABLE_MODEL_BUNDLE_ID=howreliable-rf-2022-cutoff-v1

# Required only when HOWRELIABLE_ARTIFACT_BACKEND=s3. Credentials use the standard AWS chain;
# ECS supplies short-lived credentials through the task role, never variables in this file.
HOWRELIABLE_S3_BUCKET=
HOWRELIABLE_S3_PREFIX=
HOWRELIABLE_AWS_REGION=
